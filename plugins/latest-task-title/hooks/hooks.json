{
  "description": "Refresh task titles while preserving manually chosen titles.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/latest_task_title.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\latest_task_title.py\"",
            "timeout": 3,
            "statusMessage": "Checking and refreshing task title",
            "additionalContextLimit": 700
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/latest_task_title.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\latest_task_title.py\"",
            "timeout": 3,
            "statusMessage": "Remembering automatic task title"
          }
        ]
      }
    ]
  }
}
